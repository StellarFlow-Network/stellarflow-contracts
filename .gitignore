# Rust's output directory
target

# Local settings
.soroban
.stellar

# Generated TypeScript bindings output
# Keep the packages/ directory itself (via packages/.gitkeep) but ignore
# generated content so developers run generate-bindings.sh locally.
packages/*/
!packages/.gitkeep
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
